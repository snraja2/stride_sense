# Defaults target Nebius Token Factory. Set LLM_BASE_URL and LLM_API_KEY for another provider.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=
# Legacy fallback supported when LLM_API_KEY is empty.
NEBIUS_API_KEY=
LLM_MODE=mock
# Model defaults target Nebius Token Factory; use provider-specific model IDs when switching.
LLM_MODEL_REDUCE=nvidia/Nemotron-3-Ultra-550b-a55b
LLM_MODEL_BASELINE=nvidia/Nemotron-3-Ultra-550b-a55b
LLM_MODEL_SWARM=nvidia/Nemotron-3_5-Lightning
LLM_MODEL_EYES=
LLM_MODEL_SKEPTIC=nvidia/nemotron-3-super-120b-a12b
CONCURRENCY=24
DAILY_RUN_CAP=60
IP_RUNS_PER_HOUR=3
RUNS_DIR=./runs
INCIDENTS_DIR=./incidents
PORT=8080
USE_EYES=true
